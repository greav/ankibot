# Path to the YAML config
CONFIG_PATH=./configs/config.yaml

# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=

# AnkiWeb credentials
ANKI_USERNAME=
ANKI_PASSWORD=

# OpenAI API key, used to generate vocabulary flashcards
OPENAI_API_KEY=
