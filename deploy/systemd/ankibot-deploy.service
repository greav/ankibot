# Installed to /etc/systemd/system/ankibot-deploy.service (see docs/deploy.md).
# Runs deploy.sh once; ankibot-deploy.timer decides when.
[Unit]
Description=Pull and redeploy ankibot
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/ankibot
ExecStart=/opt/ankibot/deploy.sh
